# Copie este archivo a `.env` solo si necesita cambiar algo; los valores por defecto sirven.
# El frontend NO debe contener secretos: todo lo que llegue al navegador es público.

# Puerto publicado en 127.0.0.1
FRONTEND_PORT=3000

# Dirección del backend vista desde el contenedor del frontend.
# Por defecto apunta al puerto que publica el Compose del backend en el anfitrión.
BACKEND_INTERNAL_URL=http://host.docker.internal:8000
